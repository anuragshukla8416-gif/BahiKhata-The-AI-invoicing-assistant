OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# signed at the bottom of AI-written reminders
SENDER_NAME=Your Name
# the website's address, no path. Several can be comma separated, e.g. https://bahikhata.in,https://www.bahikhata.in
FRONTEND_ORIGIN=http://localhost:5173
# decides what "today" means when working out overdue days
APP_TIMEZONE=Asia/Kolkata
# shared secret for POST /api/chase-overdue (the daily job); pick any long random string
CRON_SECRET=
# minimum days between automatic reminders on the same invoice
REMINDER_GAP_DAYS=3
# set to 1 only for local testing with the PayPal webhook simulator
SKIP_WEBHOOK_VERIFY=0
